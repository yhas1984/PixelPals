<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="0dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="44dp">

        <TextView
            android:id="@+id/txtStoreTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/store_title"
            android:textColor="@color/text_on_accent"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStoreSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:textColor="#E8F5FF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtStoreHighlight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStoreWallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_info"
            android:padding="14dp"
            android:textColor="@color/status_info_fg"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardStoreState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_info"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtStoreStatus"
                android:accessibilityLiveRegion="polite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/status_info_fg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressStoreLoading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/coral_accent"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnStoreRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/coral_accent"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/store_retry"
                android:textAllCaps="false"
                android:textColor="@color/text_on_accent"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRestorePurchases"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/golden_accent"
            android:text="@string/store_restore"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/store_premium_pets"
            android:textColor="@color/text_on_accent"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/premiumPetsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/store_accessories"
            android:textColor="@color/text_on_accent"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/accessoriesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
