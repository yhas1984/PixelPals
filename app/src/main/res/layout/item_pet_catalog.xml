<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPetItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_pet"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgPetPreview"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_pet_avatar"
        android:contentDescription="@null"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtPetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPetDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txtPetBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_info"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_info_fg"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtPetState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtPetPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/golden_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPetAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/golden_accent"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
