<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission for floating window -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets Android list PixelPals in Settings > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Vibration permission -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelPals"
        tools:targetApi="36">

        <!-- AdMob (banner adaptativo en la tienda) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${adMobAppId}" />

        <!-- AppCompat persists the in-app language choice on Android 12 and earlier. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Main Activity: Onboarding & Permissions -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PixelPals">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pet Selection Screen -->
        <activity
            android:name=".PetSelectionActivity"
            android:exported="false"
            android:label="@string/choose_your_pet"
            android:theme="@style/Theme.PixelPals" />

        <activity
            android:name=".status.PetDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.PixelPals"
            android:label="@string/dashboard_title" />

        <activity
            android:name=".feature.store.StoreActivity"
            android:exported="false"
            android:theme="@style/Theme.PixelPals"
            android:label="@string/store_title" />

        <!-- Pet Foreground Service -->
        <service
            android:name=".PetService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            tools:targetApi="36">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_special_use_subtype" />
        </service>

        <!-- Treasure Album UI -->
        <activity
            android:name=".feature.treasure.TreasureAlbumActivity"
            android:exported="false"
            android:theme="@style/Theme.PixelPals"
            android:label="@string/treasure_album_title" />

    </application>

</manifest>
